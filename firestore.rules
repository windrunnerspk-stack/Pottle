rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'createdAt', 'email', 'displayName', 'photoURL']) &&
        data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'categoryId', 'date', 'time']) &&
        data.keys().hasOnly(['userId', 'type', 'amount', 'categoryId', 'date', 'time', 'note', 'createdAt', 'syncedToICloud']) &&
        data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
        data.type is string && (data.type == 'expense' || data.type == 'income') &&
        data.amount is number && data.amount >= 0 && data.amount <= 1000000000 &&
        data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 64 &&
        data.date is string && data.date.size() <= 10 &&
        data.time is string && data.time.size() <= 8 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 200)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('syncedToICloud' in data) || (data.syncedToICloud is bool));
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(request.resource.data) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if isValidId(userId) && isOwner(userId);

      // User's private transactions subcollection
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isValidId(transactionId) && isOwner(userId) &&
          isValidTransaction(request.resource.data) &&
          request.resource.data.userId == request.auth.uid;
        allow update: if isValidId(transactionId) && isOwner(userId) &&
          isValidTransaction(request.resource.data) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isValidId(transactionId) && isOwner(userId);
      }
    }
  }
}
